APP_ENV=development
# Keep real Supabase/Postgres credentials in .env only. Never commit service_role, anon, or database passwords.
# Recommended for Supabase: Session Pooler URI, especially on IPv4-only networks.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional legacy OrderAgent direct Supabase mode, used only when no SQLAlchemy store is injected.
# Do not put these values in frontend source code.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_ORDERS_TABLE=orders
SUPABASE_ORDER_ADDRESSES_TABLE=order_addresses
SUPABASE_ORDER_TIME_COLUMN=create_time
