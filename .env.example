APP_ENV=development
# Keep real Supabase/Postgres credentials in .env only. Never commit service_role keys.
DATABASE_URL=postgresql+psycopg://postgres:password@db.xxxxx.supabase.co:5432/postgres
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional OrderAgent direct Supabase mode, used when no SQLAlchemy store is injected.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_ORDERS_TABLE=orders
SUPABASE_ORDER_ADDRESSES_TABLE=order_addresses
SUPABASE_ORDER_TIME_COLUMN=create_time
