# Copy this file to .env.supabase or .env, then replace <db-password>.
# Use Supabase Project Settings -> Connect -> Direct/Pooler connection string.
# Session Pooler is recommended for local IPv4-only networks.
# Do not paste anon/service_role JWT keys here; SQLAlchemy needs the Postgres database password.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Optional: only needed if you want LLM routing/embeddings. Keep it server-side.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# RAG pgvector column is vector(1536), matching text-embedding-3-small defaults.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional DeepSeek mode. Keep the real key only in local .env/.env.supabase.
DEEPSEEK_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-v4-flash
