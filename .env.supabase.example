# Copy this file to .env.supabase or .env, then replace <db-password>.
# Use Supabase Project Settings -> Database -> Connection string -> URI.
# Do not paste anon/service_role JWT keys here; SQLAlchemy needs the Postgres database password.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:<db-password>@db.ksfxhqtqivprvtxeqska.supabase.co:5432/postgres

# Optional: only needed if you want LLM routing/embeddings. Keep it server-side.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
